# Build-time (inlined into the browser bundle by scripts/build.js; public values only)
AI_ENABLED=false
AI_SERVER_URL=http://localhost:3001

# Game server (server/; never shipped to the browser)
JWT_SECRET=replace-with-a-long-random-string
# The AI server app this game's player tokens are issued for (the token audience).
AI_APP_ID=kitten-crawler
# This server's public origin: the issuer of player tokens and the host of /.well-known/jwks.json.
PUBLIC_URL=http://localhost:3000
# Where the ES256 signing key is generated on first run (gitignored). Or set AI_SIGNING_KEY_PEM
# to a PKCS#8 P-256 private key to supply one instead.
AI_SIGNING_KEY_DIR=.keys

# npm run ai:sync (a deploy-time script; never shipped to the browser). A service account on the
# AI server app above with the characters:write, tools:write and lore:write scopes.
AI_SYNC_CLIENT_ID=replace-with-the-service-account-id
AI_SYNC_CLIENT_SECRET=replace-with-the-service-account-secret
